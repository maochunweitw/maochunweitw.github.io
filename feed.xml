---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom">

  <channel>

    <title>{{ site.title | xml_escape }}</title>

    <description>{{ site.description | xml_escape }}</description>

    <link>https://maochunweitw.github.io/</link>

    <atom:link
      href="https://maochunweitw.github.io/feed.xml"
      rel="self"
      type="application/rss+xml" />

    {% for post in site.posts %}
    <item>

      <title>{{ post.title | xml_escape }}</title>

      <description>
        {{ post.content | strip_html | strip_newlines | xml_escape }}
      </description>

      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>

      <link>https://maochunweitw.github.io{{ post.url }}</link>

      <guid isPermaLink="true">
        https://maochunweitw.github.io{{ post.url }}
      </guid>

    </item>
    {% endfor %}

  </channel>

</rss>
